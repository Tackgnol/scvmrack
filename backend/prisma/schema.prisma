generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id
  name          String
  email         String      @unique
  emailVerified Boolean     @default(false)
  image         String?
  isAnonymous   Boolean?    @default(false)
  logto_sub     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  sessions   Session[]
  accounts   Account[]
  characters Character[]
  parties    Party[]

  @@map("user")
}

model Party {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @default("Untitled Warband") @db.VarChar(120)
  ownerUserId String   @map("owner_user_id")
  inviteToken String   @unique @map("invite_token")
  obrRoomId   String?  @unique @map("obr_room_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner   User        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  members Character[]
  enemies Enemy[]

  @@index([ownerUserId])
  @@map("parties")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model ClaimCode {
  code                   String   @id
  payload_user_id        String
  payload_source_user_id String
  payload_character_id   String
  payload_signature      String
  payload_issued_at      DateTime
  expires_at             DateTime

  @@map("claim_code")
}

model Character {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  classId         Int?     @map("class_id")
  bodyDescription String?  @map("body_description")
  habit           String?
  tale            String?
  trait1          String?
  trait2          String?
  origin          String?  @db.VarChar(255)
  strength        Int      @default(0)
  agility         Int      @default(0)
  presence        Int      @default(0)
  toughness       Int      @default(0)
  maxHp           Int      @default(1) @map("max_hp")
  currentHp       Int      @default(1) @map("current_hp")
  omens           Int?     @default(0)
  maxOmens        Int?     @default(0) @map("max_omens")
  equipment       Json?    @default("[]")
  equippedWeapons Json?    @default("[]") @map("equipped_weapons")
  equippedArmor   Json?    @map("equipped_armor")
  abilities       Json?    @default("[]")
  pets            Json?    @default("[]")
  ammo            Int?     @default(0)
  silver          Int?     @default(0)
  wounded         Boolean? @default(false)
  dead            Boolean? @default(false)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  storage         Json?    @default("[]")
  notes           String?  @default("")
  sessionId       String?  @map("session_id")
  userId          String?  @map("user_id")
  modifiers       Json     @default("[]") @map("modifiers")
  partyId         String?  @map("party_id") @db.Uuid
  joinedAt        DateTime? @map("joined_at")
  obrRoomId       String?  @map("obr_room_id")
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  party           Party?   @relation(fields: [partyId], references: [id], onDelete: SetNull)

  @@index([classId], map: "idx_characters_class")
  @@index([createdAt], map: "idx_characters_created")
  @@index([sessionId], map: "idx_characters_session_id")
  @@index([userId], map: "idx_characters_user_id")
  @@index([partyId], map: "idx_characters_party_id")
  @@map("characters")
}

model Enemy {
  id               String   @id @default(uuid()) @db.Uuid
  partyId          String   @map("party_id") @db.Uuid
  name             String   @db.VarChar(80)
  type             String   @default("") @db.VarChar(80)
  habitat          String   @default("") @db.VarChar(120)
  description      String   @default("") @db.VarChar(500)
  playerDescription String  @default("") @map("player_description") @db.VarChar(500)
  currentHealth    Int      @default(1) @map("current_health")
  maxHealth        Int      @default(1) @map("max_health")
  morale           Int      @default(0)
  armorDie         String   @default("") @map("armor_die") @db.VarChar(24)
  armorDescription String   @default("") @map("armor_description") @db.VarChar(120)
  attacks          Json     @default("[]")
  specials         Json     @default("[]")
  loot             Json     @default("[]")
  statuses         Json     @default("[]")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@map("enemies")
}

model Class {
  id                  Int      @id @default(autoincrement())
  name                String   @unique @db.VarChar(255)
  roll                Int?
  appendix            String?
  hpDie               Int?     @default(8) @map("hp_die")
  weaponDie           Int?     @default(10) @map("weapon_die")
  armorDie            Int?     @default(4) @map("armor_die")
  silverDice          Int[]    @default([6, 6]) @map("silver_dice")
  silverModifier      Int?     @default(10) @map("silver_modifier")
  statModifiers       Json?    @default("{}") @map("stat_modifiers")
  classAbilities      Json?    @default("[]") @map("class_abilities")
  randomAbilities     Json?    @default("[]") @map("random_abilities")
  randomAbilityCount  Int?     @default(1) @map("random_ability_count")
  nameKey             String?  @db.VarChar(255) @map("name_key")
  descriptionKey      String?  @db.VarChar(255) @map("description_key")

  @@map("classes")
}

model Ability {
  id        Int      @id @default(autoincrement())
  classId   Int?     @map("class_id")
  key       String   @unique @db.VarChar(255)
  isRandom  Boolean? @default(false) @map("is_random")
  rollValue Int?     @map("roll_value")

  @@map("abilities")
}

model Origin {
  id      Int    @id @default(autoincrement())
  classId Int?   @map("class_id")
  roll    Int
  key     String @db.VarChar(255)

  @@map("origins")
}

model Weapon {
  id             Int     @id @default(autoincrement())
  key            String  @unique @db.VarChar(255)
  tags           String[]
  amountMin      Int?    @map("amount_min")
  amountMax      Int?    @map("amount_max")
  mod            String? @db.VarChar(50)
  dice           Int[]   @default([])
  roll           Int?
  value          Int?    @default(0)
  exp            Boolean? @default(false)
  effectDie      Int?    @map("effect_die")
  effect         Json?
  damageModifier Int?    @default(0) @map("damage_modifier")
  modifiers      Json?   @default("[]")
  ammoType       String? @db.VarChar(50) @map("ammo_type")
  defaultAmount  Int?    @map("default_amount")

  @@map("weapons")
}

model Armor {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(255)
  tags      String[]
  dice      Int[]    @default([])
  roll      Int?
  value     Int?     @default(0)
  exp       Boolean? @default(false)
  maxTier   Int?     @default(1) @map("max_tier")
  modifiers Json?    @default("[]")

  @@map("armors")
}

model Equipment {
  id            Int      @id @default(autoincrement())
  key           String   @unique @db.VarChar(255)
  tags          String[]
  amountMin     Int?     @map("amount_min")
  amountMax     Int?     @map("amount_max")
  mod           String?  @db.VarChar(50)
  hpMin         Int?     @map("hp_min")
  hpMax         Int?     @map("hp_max")
  hpMod         Int?     @map("hp_mod")
  value         Int?     @default(0)
  exp           Boolean? @default(false)
  roll          Int?
  multiple      Int?     @default(1)
  ammoType      String?  @db.VarChar(50) @map("ammo_type")
  defaultAmount Int?     @map("default_amount")
  useEffect     Json?    @map("use_effect")

  @@map("equipment")
}

model Pet {
  id         Int      @id @default(autoincrement())
  key        String   @unique @db.VarChar(255)
  hp         Int      @default(1)
  tags       String[] @default([])
  exp        Boolean? @default(false)
  actionDie  Int[]    @default([]) @map("action_die")
  actionType String?  @default("melee") @db.VarChar(50) @map("action_type")
  amount     Int?     @default(1)
  amountDie  Int?     @map("amount_die")
  buff       Json?    @default("[]")
  value      Int?     @default(0)

  @@map("pets")
}

model Name {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(255)

  @@map("names")
}

model BodyDescription {
  id   Int    @id @default(autoincrement())
  key  String @unique @db.VarChar(255)
  roll Int?

  @@map("body_descriptions")
}

model Habit {
  id    Int      @id @default(autoincrement())
  key   String   @unique @db.VarChar(255)
  roll  Int?
  exp   Boolean? @default(false)
  items Json?    @default("[]")

  @@map("habits")
}

model Tale {
  id    Int      @id @default(autoincrement())
  key   String   @unique @db.VarChar(255)
  roll  Int?
  exp   Boolean? @default(false)
  items Json?    @default("[]")

  @@map("tales")
}

model Trait {
  id   Int    @id @default(autoincrement())
  key  String @unique @db.VarChar(255)
  roll Int?

  @@map("traits")
}

model Translation {
  locale String @db.VarChar(10)
  key    String @db.VarChar(255)
  value  String

  @@id([locale, key])
  @@map("translations")
}

model ClassAbilityModifier {
  id         Int    @id @default(autoincrement())
  classId    Int    @map("class_id")
  abilityKey String @db.VarChar(255) @map("ability_key")
  value      Int
  statistic  String @db.VarChar(20)
  exclude    Json   @default("[]")
  source     String
  notes      String?

  @@unique([classId, abilityKey, statistic, value, exclude])
  @@map("class_ability_modifiers")
}
