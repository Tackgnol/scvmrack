{
  "name": "scvmgrinder_be",
  "version": "0.5.7",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "type": "module",
  "directories": {
    "test": "tests/unit-be"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npm --prefix tests/unit-be run test && npm --prefix ../frontend run test",
    "test:browser": "npm --prefix ../frontend run test:browser",
    "test:integration": "node --import tsx scripts/run-integration-be-docker.ts",
    "test:e2e": "node --import tsx scripts/run-e2e-docker.ts",
    "test:prod-smoke": "npm --prefix tests/e2e run test:prod-smoke",
    "test:coverage:backend": "c8 --reporter=json --reporter=text --reporter=lcov --report-dir=coverage-backend npm --prefix tests/unit-be run test",
    "test:coverage:client": "npm --prefix ../frontend run test:coverage:unit && npm --prefix ../frontend run test:coverage:browser",
    "test:coverage:merge": "node --import tsx scripts/merge-all-coverage.ts",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:client && npm run test:coverage:merge",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:browser && npm run test:e2e",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "tsc",
    "watch:ts": "tsc -w",
    "dev": "docker compose -f ../compose.dev.yaml up --build --watch",
    "dev:api": "npm run build:ts && concurrently -k -p \"[{name}]\" -n \"TypeScript,App\" -c \"yellow.bold,cyan.bold\" \"npm:watch:ts\" \"npm:dev:api:start\"",
    "dev:api:start": "fastify start --ignore-watch=.ts$ -w -l info -P dist/app.js",
    "dev:client": "npm --prefix ../frontend run dev",
    "deploy:prepare": "npm run build:ts && npm --prefix ../frontend run build && node scripts/prepare-deploy.js",
    "deploy:env": "node scripts/parse-env.js",
    "migrate": "node scripts/migrate.js",
    "migrate:local": "node scripts/migrate-local.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:baseline": "prisma migrate resolve --applied 20260603000000_init_full",
    "prisma:seed": "node --import tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@sentry/node": "^10.50.0",
    "@tackgnol/rpg-tools-roller": "^0.0.1",
    "@tackgnol/rpgtools-owlbear": "^0.1.0",
    "@tackgnol/rpgtools-shared-auth": "^1.6.0",
    "dotenv": "^17.3.1",
    "fastify": "5.8.5",
    "fastify-cli": "^7.4.1",
    "fastify-plugin": "^5.1.0",
    "minisearch": "^7.2.0",
    "pg": "^8.16.3",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@fastify/type-provider-json-schema-to-ts": "^5.0.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.0.8",
    "@types/pg": "^8.16.0",
    "@types/validator": "^13.15.10",
    "c8": "^10.1.2",
    "concurrently": "^9.0.0",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "6.19.3",
    "ts-node": "^10.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  }
}
