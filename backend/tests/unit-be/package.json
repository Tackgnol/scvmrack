{
  "name": "scvmgrinder-unit-be",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --experimental-test-module-mocks --test \"**/*.test.ts\"",
    "test:run": "npm run test",
    "test:report": "node --import tsx --experimental-test-module-mocks --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=../../reports/unit-be.xml \"**/*.test.ts\""
  }
}
