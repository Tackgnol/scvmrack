# Security headers for the frontend (HTML document + static assets). Mirrors the
# backend's helmet policy so the app — not just the API JSON — is protected.
# NOT applied to /api/* because the backend (helmet) already sets its own headers;
# setting them in both places would produce conflicting/duplicate CSP headers.
(frontend_security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # No X-Frame-Options: it can't express an allowlist, and any value would
    # fight the CSP frame-ancestors directive below on older browsers.
    # frame-ancestors allows itch.io embeds (itch serves uploaded HTML from
    # *.itch.zone, with itch.io as the top-level page) — see itch/README.md.
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self' https://itch.io https://*.itch.io https://*.itch.zone; form-action 'self'; img-src 'self' data: https://www.google-analytics.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com; upgrade-insecure-requests"
  }
}

scvmrack.rpgtools.co {
  import cloudflare_tls

  @asset_routes path /assets/*
  handle @asset_routes {
    import frontend_security_headers
    reverse_proxy 127.0.0.1:3030
  }

  @api_routes path /api/*
  handle @api_routes {
    reverse_proxy 127.0.0.1:3031
  }

  handle {
    import frontend_security_headers
    reverse_proxy 127.0.0.1:3030
  }
}

# Dev environment — deployed from the `dev` branch (.woodpecker/deploy-dev.yaml).
# Same routing as prod, pointed at the scvmrack-dev stack's published ports
# (frontend 3050, backend 3051).
scvmrack-dev.rpgtools.co {
  import cloudflare_tls

  @asset_routes path /assets/*
  handle @asset_routes {
    import frontend_security_headers
    reverse_proxy 127.0.0.1:3050
  }

  @api_routes path /api/*
  handle @api_routes {
    reverse_proxy 127.0.0.1:3051
  }

  handle {
    import frontend_security_headers
    reverse_proxy 127.0.0.1:3050
  }
}
