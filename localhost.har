          "content": {
            "size": 2648,
            "mimeType": "application/json",
            "compression": 0,
            "text": "{\"id\":\"10723656-0349-4a40-96d0-27e5718ca044\",\"name\":\"Aslan\",\"classId\":4,\"className\":\"Wretched Royalty\",\"classDescription\":\"Bowed down only by the memories of your own lost glory, you could never submit to anyone else. Not you, of noble blood!\",\"origin\":\"Things were going so well, until Anthelia demanded a gift of noble blood.\",\"strength\":11,\"agility\":8,\"presence\":11,\"toughness\":11,\"maxHp\":1,\"currentHp\":1,\"omens\":2,\"maxOmens\":2,\"silver\":80,\"habit\":\"Stress response is aesthetic display. The worse things get the fancier you need to be.\",\"tale\":\"'Burn or be burned' is the fate you accept.\",\"bodyDescription\":\"One hand is replaced with a rusting hook\",\"trait1\":\"egocentric\",\"trait2\":\"nihilistic\",\"notes\":\"\",\"abilities\":[{\"key\":\"abilities.wretched_royalty.horn\",\"name\":\"Horn of the Schleswig Lords: Once per day release a blare from this dented old trumpet and test Presence DR12. One creature may make their next non-combat test an automatic success.\",\"description\":\"\"},{\"key\":\"abilities.wretched_royalty.hamfund\",\"name\":\"Hamfund the Squire: This intensely cowardly servant acts only as guardian for the scabbard of the cursed sword Eurekia. Once per combat, if Ham can be found, Eurekia may be drawn. The sword does 2D6 damage, and for every swing of Eurekia roll a D6. On a 1 the squire is slain and Eurekia vanishes forever.\",\"description\":\"\"}],\"equipment\":[{\"key\":\"equipment.tent\",\"name\":\"Tent\",\"description\":\"\",\"uses\":[],\"dice\":[],\"tags\":[\"camping\"],\"amount\":0,\"ammoType\":\"\"},{\"key\":\"equipment.red-poison\",\"name\":\"A Bottle of Red Poison\",\"description\":\"Toughness DR12 or d10 damage\",\"uses\":[false,false,false,false],\"dice\":[],\"tags\":[\"consumable\",\"poison\"],\"amount\":0,\"ammoType\":\"\"},{\"key\":\"pets.hamfund\",\"name\":\"Hamfund the Squire\",\"description\":\"This intensely cowardly servant acts only as guardian for the scabbard of the cursed sword Eurekia. Once per combat, if Ham can be found, Eurekia may be drawn for 2D6 damage. For every swing of Eurekia roll a D6. On a 1 the squire is slain and Eurekia vanishes forever.\",\"uses\":[true],\"dice\":[6],\"tags\":[\"humanoid\",\"pet\",\"special\"],\"amount\":0,\"ammoType\":\"\"}],\"storage\":[],\"equippedWeapons\":[{\"key\":\"weapons.shortsword\",\"name\":\"Shortsword\",\"description\":\"d4 damage\",\"dice\":[4],\"tags\":[\"weapon\",\"melee\"],\"ammoType\":\"\"}],\"equippedArmor\":{\"key\":\"armor.padded-cloth\",\"name\":\"Padded Cloth Armor\",\"description\":\"-d2 damage, tier 1\",\"dice\":[2],\"maxTier\":1,\"currentTier\":1,\"tags\":[\"armor\",\"light-armor\"]},\"modifiers\":[],\"computedModifiers\":[],\"encumbrance\":4,\"maxEncumbrance\":8,\"drToDodge\":13,\"drToMelee\":12,\"drToRanged\":12,\"createdAt\":\"2026-04-03T10:37:11.323Z\",\"updatedAt\":\"2026-04-03T10:37:11.323Z\"}"
          },
