{
  "name": "mork-borg-character-sheet",
  "private": true,
  "version": "0.6.0",
  "author": "Adam Kościelniak",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "check:monitoring": "node scripts/check-monitoring-build.mjs",
    "build:mydevil": "tsc -p tsconfig.build.json && vite build --mode mydevil",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:browser:all": "node scripts/run-browser-matrix.mjs",
    "test:browser:ui": "vitest --ui --config vitest.browser.config.ts",
    "test:report": "npm run test:report:unit",
    "test:report:unit": "vitest run --reporter=verbose --reporter=junit --outputFile.junit=../backend/reports/client-unit.xml",
    "test:report:browser": "vitest run --config vitest.browser.config.ts --reporter=verbose --reporter=junit --outputFile.junit=../backend/reports/client-browser.xml",
    "test:coverage:unit": "vitest run --coverage.enabled --coverage.reportsDirectory=./coverage-unit --coverage.reporter=json --coverage.reporter=text",
    "test:coverage:browser": "vitest run --config vitest.browser.config.ts --coverage.enabled --coverage.reporter=json --coverage.reporter=text",
    "test:coverage:merge": "node --import tsx ../backend/scripts/merge-client-coverage.ts",
    "test:coverage": "npm run test:coverage:unit && npm run test:coverage:browser && npm run test:coverage:merge",
    "test:unit:report": "npm run test:report:unit",
    "test:browser:report": "npm run test:report:browser",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "generate-api": "openapi-typescript http://localhost:3000/openapi.json -o src/api/schema.ts --enum",
    "analyze": "vite build --analyze",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@analytics/google-analytics": "^1.1.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "^7.3.6",
    "@sentry/react": "^10.50.0",
    "@tackgnol/rpgtools-owlbear": "^0.1.0",
    "@tackgnol/rpgtools-shared-auth": "^1.6.0",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-router": "^1.153.2",
    "analytics": "^0.8.19",
    "i18next": "^25.7.4",
    "i18next-browser-languagedetector": "^8.2.0",
    "motion": "^12.34.3",
    "openapi-fetch": "^0.15.0",
    "openapi-react-query": "^0.5.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^16.5.2",
    "use-debounce": "^10.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@owlbear-rodeo/sdk": "^3.1.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.0.1",
    "openapi-typescript": "^7.10.1",
    "playwright": "^1.58.2",
    "prettier": "^3.4.2",
    "rollup-plugin-visualizer": "^7.0.0",
    "typescript": "^5.3.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.8",
    "vitest-browser-react": "^2.1.0"
  }
}
